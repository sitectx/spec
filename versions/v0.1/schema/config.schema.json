{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/config.schema.json",
  "title": "SiteCTX v0.1 CLI Config",
  "type": "object",
  "required": [
    "siteUrl",
    "name",
    "description",
    "language",
    "publisher",
    "sections",
    "updates"
  ],
  "properties": {
    "siteUrl": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35
    },
    "verticalPreset": {
      "type": "string",
      "enum": [
        "ecommerce",
        "nonprofit",
        "saas",
        "local-business",
        "docs"
      ]
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/updateInput"
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string"
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "canonicalFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "sourcePages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcePage"
      }
    },
    "discoveryCandidates": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "facts": {
          "type": "array"
        },
        "claims": {
          "type": "array"
        },
        "faq": {
          "type": "array"
        },
        "pages": {
          "type": "array"
        }
      }
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "summary"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "updateInput": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url",
        "title",
        "summary"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sourcePage": {
      "type": "object",
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "purpose": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "discoveredAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceText": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "telephone": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "url",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "detected",
            "configured",
            "missing",
            "stale",
            "error"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "format": {
          "type": "string",
          "maxLength": 120
        },
        "requiresSetup": {
          "type": "boolean"
        },
        "sampleUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reviewableItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "reviewRequired": {
          "type": "boolean"
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft_review_required",
            "reviewed"
          ]
        },
        "source": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "ecommerce",
            "nonprofit",
            "saas",
            "local-business",
            "docs"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "pagesFetched": {
          "type": "integer",
          "minimum": 0
        },
        "pagesIncluded": {
          "type": "integer",
          "minimum": 0
        },
        "corpusPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
