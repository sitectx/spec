{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/config.schema.json",
  "title": "SiteCTX v0.1 CLI Config",
  "type": "object",
  "required": [
    "siteUrl",
    "name",
    "description",
    "language",
    "publisher",
    "sections",
    "updates"
  ],
  "properties": {
    "siteUrl": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/updateInput"
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string"
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "canonicalFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewableItem"
      }
    },
    "sourcePages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcePage"
      }
    },
    "discoveryCandidates": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "facts": {
          "type": "array"
        },
        "claims": {
          "type": "array"
        },
        "faq": {
          "type": "array"
        },
        "pages": {
          "type": "array"
        }
      }
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "summary"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "updateInput": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url",
        "title",
        "summary"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sourcePage": {
      "type": "object",
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "purpose": {
          "type": "string",
          "maxLength": 500
        },
        "lastReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "discoveredAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviewableItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "reviewRequired": {
          "type": "boolean"
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft_review_required",
            "reviewed"
          ]
        },
        "source": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "pagesFetched": {
          "type": "integer",
          "minimum": 0
        },
        "pagesIncluded": {
          "type": "integer",
          "minimum": 0
        },
        "corpusPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
