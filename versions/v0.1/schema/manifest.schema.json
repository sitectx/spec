{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/manifest.schema.json",
  "title": "SiteCTX v0.1 Discovery Manifest",
  "type": "object",
  "required": [
    "specVersion",
    "kind",
    "site",
    "generatedAt",
    "context"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "sitectx.manifest"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "catalogs": {
      "$ref": "#/$defs/link"
    },
    "generatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "context": {
      "$ref": "#/$defs/link"
    },
    "updates": {
      "$ref": "#/$defs/link"
    },
    "updatesNdjson": {
      "$ref": "#/$defs/link"
    },
    "evidence": {
      "$ref": "#/$defs/link"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "error"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "role": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "url",
        "contentType"
      ],
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceText": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "telephone": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
