{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/manifest.schema.json",
  "title": "SiteCTX v0.1 Discovery Manifest",
  "type": "object",
  "required": [
    "specVersion",
    "kind",
    "site",
    "generatedAt",
    "context"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "sitectx.manifest"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "generatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "context": {
      "$ref": "#/$defs/link"
    },
    "updates": {
      "$ref": "#/$defs/link"
    },
    "updatesNdjson": {
      "$ref": "#/$defs/link"
    },
    "evidence": {
      "$ref": "#/$defs/link"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "url",
        "contentType"
      ],
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
