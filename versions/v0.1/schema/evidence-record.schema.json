{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/evidence-record.schema.json",
  "title": "SiteCTX v0.1 Evidence Record",
  "type": "object",
  "required": [
    "specVersion",
    "kind",
    "id",
    "site",
    "sourceUrl",
    "observedAt",
    "contentType",
    "summary",
    "hash",
    "relatedRecordIds"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "sitectx.evidenceRecord"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "observedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "contentType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hashNote": {
      "type": "string",
      "maxLength": 500
    },
    "relatedRecordIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
