{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitectx.org/versions/v0.1/schema/context.schema.json",
  "title": "SiteCTX v0.1 Context Snapshot",
  "type": "object",
  "required": [
    "specVersion",
    "sitectx_version",
    "kind",
    "site",
    "freshness",
    "records"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1"
    },
    "sitectx_version": {
      "const": "0.1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sitectx.context"
      ]
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": true
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "generatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sourcePages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "commercialContext": {
      "$ref": "#/$defs/commercialContext"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "language": {
          "type": "string",
          "maxLength": 35
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "status",
        "generated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "error"
          ]
        },
        "generated_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "role": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "type",
        "observed_at"
      ],
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "source_url"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "page",
            "entity",
            "offer",
            "update"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "page_role": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "type",
        "url",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceText": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "logo": {
          "type": "string",
          "format": "uri"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "telephone": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "url",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "detected",
            "configured",
            "missing",
            "stale",
            "error"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "format": {
          "type": "string",
          "maxLength": 120
        },
        "requiresSetup": {
          "type": "boolean"
        },
        "sampleUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "observedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commercialContext": {
      "type": "object",
      "required": [
        "enabled",
        "sponsoredContextUrl",
        "policy"
      ],
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "const": true
        },
        "sponsoredContextUrl": {
          "type": "string",
          "format": "uri"
        },
        "policy": {
          "type": "object",
          "required": [
            "sponsoredContentMustBeDisclosed",
            "agentClicksAreNotBillable",
            "requiresCanonicalLandingPage"
          ],
          "additionalProperties": true,
          "properties": {
            "sponsoredContentMustBeDisclosed": {
              "const": true
            },
            "agentClicksAreNotBillable": {
              "const": true
            },
            "paidPlacementsAllowed": {
              "type": "boolean"
            },
            "affiliateLinksAllowed": {
              "type": "boolean"
            },
            "requiresCanonicalLandingPage": {
              "const": true
            }
          }
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
